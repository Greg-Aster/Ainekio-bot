[Unit]
Description=Ainekio Freestyle generator and inference recording
Wants=llama-cpp.service

[Service]
WorkingDirectory=%h/Ainekio
EnvironmentFile=%h/.config/ainekio/freestyle.env
ExecStart=/usr/bin/env ${FREESTYLE_PYTHON} -m experiments.freestyle.generator --endpoint ${FREESTYLE_ENDPOINT} --model ${FREESTYLE_MODEL} --contract ${FREESTYLE_CONTRACT} --model-file ${FREESTYLE_MODEL_FILE} --adapter-file ${FREESTYLE_ADAPTER_FILE} --recordings ${FREESTYLE_RECORDINGS}

[Install]
WantedBy=default.target
