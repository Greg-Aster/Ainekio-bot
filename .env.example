# Optional MetaHuman environment adapter; standalone Body Control needs no bridge.
# Configure the same value as MH_ENVIRONMENT_ADAPTER_TOKEN in MetaHuman OS.
AINEKIO_ENVIRONMENT_ADAPTER_TOKEN=replace-with-a-long-random-token
AINEKIO_ENVIRONMENT_SESSION_ID=ainekio-01

# Local gateway advertisement. P4 needs gateway_switching_v1 for discovery.
AINEKIO_LOCAL_DISCOVERY=1

# Transfer saved robot pairing and the dashboard password with the launcher's
# --export-pairing / --import-pairing commands. Machine-specific paths and
# MetaHuman/Cloudflare credentials are kept local; do not share a venv path.
# AINEKIO_DASHBOARD_HOST=127.0.0.1

# Start/stop an installed host hotspot with the physical gateway (opt-in).
# Requires the ainekio-hotspot system services and permission to control them.
AINEKIO_HOTSPOT=0

# Optional recognition: set both URL and model to enable the existing worker.
# Remote endpoints require HTTPS with a trusted certificate and API-key auth.
# Never place a secret in the URL. Keep the key only in the ignored .env.
# AINEKIO_VISION_URL=https://your-recognition-host/v1/chat/completions
# AINEKIO_VISION_MODEL=your-served-vision-model
# AINEKIO_VISION_API_KEY=your-service-key

# Optional remote robot relay. Keep the credential JSON outside the repo.
AINEKIO_CLOUDFLARE_TUNNEL_ID=replace-with-ainekio-robot-tunnel-uuid
AINEKIO_CLOUDFLARE_CREDENTIALS_FILE=/absolute/path/outside/repo/tunnel-credentials.json
