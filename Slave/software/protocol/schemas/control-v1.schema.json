{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ainekio.local/protocol/control-v1.schema.json",
  "title": "Ainekio control protocol v1",
  "description": "One JSON object carried by one WebSocket text frame. Unknown additional fields on known messages are ignored for forward compatibility.",
  "properties": {
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "clock_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/err"
    },
    {
      "$ref": "#/$defs/welcome"
    },
    {
      "$ref": "#/$defs/intent"
    },
    {
      "$ref": "#/$defs/stop"
    },
    {
      "$ref": "#/$defs/motion_plan"
    },
    {
      "$ref": "#/$defs/tts"
    },
    {
      "$ref": "#/$defs/cam"
    },
    {
      "$ref": "#/$defs/snap"
    },
    {
      "$ref": "#/$defs/mic"
    },
    {
      "$ref": "#/$defs/speaker"
    },
    {
      "$ref": "#/$defs/wake"
    },
    {
      "$ref": "#/$defs/profile"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/ping"
    },
    {
      "$ref": "#/$defs/mode"
    },
    {
      "$ref": "#/$defs/servo"
    },
    {
      "$ref": "#/$defs/limits"
    },
    {
      "$ref": "#/$defs/pose_save"
    },
    {
      "$ref": "#/$defs/cal_save"
    },
    {
      "$ref": "#/$defs/calibration"
    },
    {
      "$ref": "#/$defs/calibration_status"
    },
    {
      "$ref": "#/$defs/motion_speed"
    },
    {
      "$ref": "#/$defs/motion_speed_status"
    },
    {
      "$ref": "#/$defs/storage"
    },
    {
      "$ref": "#/$defs/storage_status"
    },
    {
      "$ref": "#/$defs/ack"
    },
    {
      "$ref": "#/$defs/nak"
    },
    {
      "$ref": "#/$defs/done"
    },
    {
      "$ref": "#/$defs/cancelled"
    },
    {
      "$ref": "#/$defs/status"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/cam_meta"
    },
    {
      "$ref": "#/$defs/pong"
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "playback_rate"
        ]
      },
      "then": {
        "required": [
          "t",
          "name"
        ],
        "properties": {
          "t": {
            "const": "intent"
          },
          "name": {
            "enum": [
              "sit",
              "stand",
              "emote"
            ]
          },
          "playback_rate": {
            "$ref": "#/$defs/motionRate"
          }
        }
      }
    }
  ],
  "$defs": {
    "motionRate": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "motion_speed": {
      "x-ainekio-message-type": "motion_speed",
      "x-ainekio-direction": "brain-to-body",
      "type": "object",
      "required": [
        "t",
        "seq",
        "op"
      ],
      "properties": {
        "t": {
          "const": "motion_speed"
        },
        "seq": {
          "$ref": "#/$defs/sequence"
        },
        "op": {
          "enum": [
            "get",
            "save"
          ]
        },
        "rate": {
          "$ref": "#/$defs/motionRate"
        }
      },
      "if": {
        "properties": {
          "op": {
            "const": "save"
          }
        }
      },
      "then": {
        "required": [
          "rate"
        ]
      },
      "else": {
        "properties": {
          "rate": false
        }
      }
    },
    "motion_speed_status": {
      "x-ainekio-message-type": "motion_speed_status",
      "x-ainekio-direction": "body-to-brain",
      "type": "object",
      "required": [
        "t",
        "seq",
        "rate",
        "saved"
      ],
      "properties": {
        "t": {
          "const": "motion_speed_status"
        },
        "seq": {
          "$ref": "#/$defs/sequence"
        },
        "rate": {
          "$ref": "#/$defs/motionRate"
        },
        "saved": {
          "type": "boolean"
        }
      }
    },
    "bodyCapabilities": {
      "type": "object",
      "required": [
        "motion",
        "camera",
        "microphone",
        "speaker"
      ],
      "properties": {
        "motion": {
          "type": "boolean"
        },
        "camera": {
          "type": "boolean"
        },
        "microphone": {
          "type": "boolean"
        },
        "speaker": {
          "type": "boolean"
        },
        "wake": {
          "type": "boolean"
        },
        "profile": {
          "type": "boolean"
        },
        "power": {
          "type": "boolean"
        },
        "storage": {
          "type": "boolean"
        },
        "display": {
          "type": "boolean"
        },
        "calibration": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "reasons": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "maxLength": 32
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "storage": {
      "x-ainekio-message-type": "storage",
      "x-ainekio-direction": "brain-to-body",
      "type": "object",
      "required": [
        "t",
        "seq",
        "op"
      ],
      "properties": {
        "t": {
          "const": "storage"
        },
        "seq": {
          "$ref": "#/$defs/sequence"
        },
        "op": {
          "enum": [
            "get",
            "retry",
            "clear"
          ]
        }
      }
    },
    "storage_status": {
      "x-ainekio-message-type": "storage_status",
      "x-ainekio-direction": "body-to-brain",
      "type": "object",
      "required": [
        "t",
        "seq",
        "available",
        "mounted",
        "busy",
        "total_bytes",
        "free_bytes",
        "dropped_records",
        "error"
      ],
      "properties": {
        "t": {
          "const": "storage_status"
        },
        "seq": {
          "$ref": "#/$defs/sequence"
        },
        "available": {
          "type": "boolean"
        },
        "mounted": {
          "type": "boolean"
        },
        "busy": {
          "type": "boolean"
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "free_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dropped_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "error": {
          "type": "string",
          "maxLength": 160
        }
      },
      "x-ainekio-rules": [
        "storage-free-does-not-exceed-total"
      ]
    },
    "calibration": {
      "x-ainekio-message-type": "calibration",
      "x-ainekio-direction": "brain-to-body",
      "type": "object",
      "required": [
        "t",
        "seq",
        "op"
      ],
      "properties": {
        "t": {
          "const": "calibration"
        },
        "seq": {
          "$ref": "#/$defs/sequence"
        },
        "op": {
          "enum": [
            "get",
            "set",
            "move",
            "home",
            "save"
          ]
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "channel": {
          "type": "integer",
          "minimum": -1,
          "maximum": 11
        },
        "home_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "invert": {
          "type": "boolean"
        },
        "home_cd": {
          "type": "integer",
          "minimum": -36000,
          "maximum": 36000
        },
        "us_per_degree": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "pulse_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "dependentRequired": {
        "home_cd": [
          "us_per_degree"
        ],
        "us_per_degree": [
          "home_cd"
        ]
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "home_cd"
                ]
              },
              {
                "required": [
                  "us_per_degree"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "op": {
                "const": "set"
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "properties": {
            "op": {
              "enum": [
                "get",
                "save"
              ]
            }
          },
          "not": {
            "required": [
              "id"
            ]
          }
        },
        {
          "properties": {
            "op": {
              "const": "home"
            }
          }
        },
        {
          "properties": {
            "op": {
              "const": "move"
            }
          },
          "required": [
            "id",
            "pulse_us"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "set"
            }
          },
          "required": [
            "id",
            "channel",
            "home_us",
            "invert"
          ]
        }
      ]
    },
    "calibration_status": {
      "x-ainekio-message-type": "calibration_status",
      "x-ainekio-direction": "body-to-brain",
      "type": "object",
      "required": [
        "t",
        "seq",
        "dirty",
        "saved",
        "ready",
        "joints"
      ],
      "dependentRequired": {
        "pulse_min_us": [
          "pulse_max_us"
        ],
        "pulse_max_us": [
          "pulse_min_us"
        ]
      },
      "properties": {
        "t": {
          "const": "calibration_status"
        },
        "seq": {
          "$ref": "#/$defs/sequence"
        },
        "dirty": {
          "type": "boolean"
        },
        "saved": {
          "type": "boolean"
        },
        "ready": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 160
        },
        "pulse_min_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "pulse_max_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "joints": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "id",
              "channel",
              "home_us",
              "invert",
              "pulse_us"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 11
              },
              "channel": {
                "type": "integer",
                "minimum": -1,
                "maximum": 11
              },
              "home_us": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "invert": {
                "type": "boolean"
              },
              "home_cd": {
                "type": "integer",
                "minimum": -36000,
                "maximum": 36000
              },
              "us_per_degree": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "pulse_us": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "recommended_home_cd": {
                "type": "integer",
                "minimum": -36000,
                "maximum": 36000
              },
              "recommended_home_us": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "dependentRequired": {
              "home_cd": [
                "us_per_degree"
              ],
              "us_per_degree": [
                "home_cd"
              ]
            }
          }
        },
        "profile_confirmed": {
          "type": "boolean"
        },
        "shaft_travel_measured": {
          "type": "boolean"
        },
        "servo_profile_id": {
          "type": "string",
          "maxLength": 96
        },
        "provisional_us_per_degree": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "recommended_reference_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "x-ainekio-rules": [
        "unique-calibration-joints-and-channels",
        "ordered-pwm-pulse-bounds",
        "saved-is-not-dirty"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "assetName": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$"
    },
    "featureName": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$"
    },
    "profileName": {
      "type": "string",
      "enum": [
        "home",
        "tether"
      ]
    },
    "cameraResolution": {
      "type": "string",
      "enum": [
        "QVGA",
        "VGA",
        "XGA",
        "960P",
        "FHD"
      ]
    },
    "cameraSnapshotResolution": {
      "type": "string",
      "enum": [
        "QVGA",
        "VGA",
        "XGA",
        "960P",
        "FHD",
        "AUTO"
      ]
    },
    "cameraStreamResolution": {
      "type": "string",
      "enum": [
        "QVGA",
        "VGA",
        "XGA",
        "960P",
        "FHD"
      ]
    },
    "hello": {
      "x-ainekio-message-type": "hello",
      "x-ainekio-direction": "body-to-brain",
      "type": "object",
      "required": [
        "t",
        "ver",
        "fw",
        "id",
        "auth"
      ],
      "properties": {
        "t": {
          "const": "hello"
        },
        "capabilities": {
          "$ref": "#/$defs/bodyCapabilities"
        },
        "ver": {
          "const": 1
        },
        "fw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "auth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "features": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/featureName"
          },
          "x-ainekio-rules": [
            "unique-items"
          ]
        },
        "seq": false
      },
      "allOf": [
        {
          "if": {
            "required": [
              "features"
            ],
            "properties": {
              "features": {
                "contains": {
                  "const": "command_deadline_v1"
                }
              }
            }
          },
          "then": {
            "required": [
              "clock_ms"
            ]
          }
        },
        {
          "if": {
            "required": [
              "features"
            ],
            "properties": {
              "features": {
                "contains": {
                  "const": "body_commands_v1"
                }
              }
            }
          },
          "then": {
            "properties": {
              "features": {
                "contains": {
                  "const": "body_capabilities_v1"
                }
              },
              "capabilities": {
                "required": [
                  "commands"
                ],
                "properties": {
                  "commands": {
                    "type": "array",
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "features"
            ],
            "properties": {
              "features": {
                "contains": {
                  "const": "body_capabilities_v1"
                }
              }
            }
          },
          "then": {
            "required": [
              "model",
              "capabilities"
            ],
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "capabilities": {
                "type": "object",
                "required": [
                  "motion",
                  "camera",
                  "microphone",
                  "speaker"
                ],
                "properties": {
                  "motion": {
                    "type": "boolean"
                  },
                  "camera": {
                    "type": "boolean"
                  },
                  "microphone": {
                    "type": "boolean"
                  },
                  "speaker": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "err": {
      "x-ainekio-message-type": "err",
      "x-ainekio-direction": "brain-to-body",
      "type": "object",
      "required": [
        "t",
        "code"
      ],
      "properties": {
        "t": {
          "const": "err"
        },
        "code": {
          "type": "string",
          "enum": [
            "auth",
            "ver"
          ]
        },
        "seq": false
      }
    },
    "welcome": {
      "x-ainekio-message-type": "welcome",
      "x-ainekio-direction": "brain-to-body",
      "type": "object",
      "required": [
        "t",
        "ver",
        "epoch",
        "profile"
      ],
      "properties": {
        "t": {
          "const": "welcome"
        },
        "ver": {
          "const": 1
        },
        "epoch": {
          "$ref": "#/$defs/counter"
        },
        "profile": {
          "$ref": "#/$defs/profileName"
        },
        "command_deadline_v1": {
          "type": "boolean"
        },
        "seq": false
      }
    },
    "intent": {
      "x-ainekio-message-type": "intent",
      "x-ainekio-direction": "brain-to-body",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "t",
            "seq",
            "name"
          ],
          "properties": {
            "t": {
              "const": "intent"
            },
            "seq": {
              "$ref": "#/$defs/sequence"
            },
            "name": {
              "type": "string",
              "enum": [
                "sit",
                "stand",
                "neutral"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t",
            "seq",
            "name",
            "yaw",
            "pitch"
          ],
          "properties": {
            "t": {
              "const": "intent"
            },
            "seq": {
              "$ref": "#/$defs/sequence"
            },
            "name": {
              "const": "look"
            },
            "yaw": {
              "type": "integer",
              "minimum": -90,
              "maximum": 90
            },
            "pitch": {
              "type": "integer",
              "minimum": -45,
              "maximum": 45
            },
            "ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 5000
            }
          }
        },
        {
          "type": "object",
          "required": [
            "t",
            "seq",
            "name",
            "dir",
            "steps"
          ],
          "properties": {
            "t": {
              "const": "intent"
            },
            "seq": {
              "$ref": "#/$defs/sequence"
            },
            "name": {
              "const": "walk"
            },
            "dir": {
              "type": "string",
              "enum": [
                "fwd",
                "back",
                "turn_l",
                "turn_r",
                "side_l",
                "side_r"
              ]
            },
            "steps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "gait": {
              "enum": [
                "walk",
                "crawl",
                "run",
                "crab"
              ]
            },
            "forward": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            "turn": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            "speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "stride": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "rate": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 3
            },
            "update": {
              "$ref": "#/$defs/sequence"
            }
          },
          "dependentRequired": {
            "forward": [
              "turn"
            ],
            "turn": [
              "forward"
            ]
          },
          "allOf": [
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "speed",
                      "stride"
                    ]
                  },
                  {
                    "required": [
                      "speed",
                      "rate"
                    ]
                  },
                  {
                    "required": [
                      "speed_percent"
                    ]
                  },
                  {
                    "required": [
                      "stride_percent"
                    ]
                  },
                  {
                    "required": [
                      "motion_rate"
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "required": [
                  "stride"
                ]
              },
              "then": {
                "required": [
                  "rate"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "rate"
                ]
              },
              "then": {
                "required": [
                  "stride"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "update"
                ]
              },
              "then": {
                "anyOf": [
                  {
                    "required": [
                      "speed"
                    ]
                  },
                  {
                    "required": [
                      "stride",
                      "rate"
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "required": [
                  "gait"
                ],
