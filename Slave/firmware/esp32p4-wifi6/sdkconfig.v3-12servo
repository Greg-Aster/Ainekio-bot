# V3 12-servo Option A-1 (DS3225 PRO 270 deg 7.4V) on Waveshare ESP32-P4-WIFI6
# Overlay on top of sdkconfig.defaults:
#   idf.py -B build-v3 -D IDF_TARGET=esp32p4 -D SDKCONFIG=build-v3/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.v3-12servo" \
#          -D AINEKIO_C6_IMAGE= build

CONFIG_AINEKIO_MODEL_V3_12SERVO=y
CONFIG_AINEKIO_DISPLAY_ILI9341=y
CONFIG_AINEKIO_FEEDBACK_MUX_CD74HC4067=y
CONFIG_AINEKIO_LCD_ENABLED=y
CONFIG_AINEKIO_LCD_SCLK=20
CONFIG_AINEKIO_LCD_MOSI=21
CONFIG_AINEKIO_LCD_CS=22
CONFIG_AINEKIO_LCD_DC=23
CONFIG_AINEKIO_LCD_RESET=26
CONFIG_AINEKIO_LCD_SPI_HZ=40000000
CONFIG_AINEKIO_LCD_BGR=y
CONFIG_AINEKIO_LCD_INVERT=n
CONFIG_AINEKIO_LCD_ROTATE_180=n
