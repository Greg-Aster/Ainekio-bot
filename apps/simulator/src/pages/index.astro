			name="description"
			content="Standalone static-web MuJoCo WASM quadruped simulator running compiled Ainekio V2 ESP32-P4 C firmware with built-in Body Control cockpit and direct WebSocket Body Control linking."
		/>
	</head>
	<body>
		<AinekioCockpit client:only="svelte" />
	</body>
